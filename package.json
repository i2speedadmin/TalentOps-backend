{
  "name": "talentops-backend",
  "version": "7.0.0",
  "description": "TalentOps \u2014 Multi-Tenant SaaS Recruitment Task Management API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "schema": "node src/config/schema.js",
